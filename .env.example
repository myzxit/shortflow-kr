# ─── 기본 ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="openssl rand -base64 32 로 생성한 값"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── 소셜 로그인 (선택) ──────────────────────────────────────────────────
# 비워두면 이메일/비밀번호 로그인만 활성화된다.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── 결제 (선택) ─────────────────────────────────────────────────────────
# 비워두면 결제 페이지가 "모의 결제" 모드로 동작해 크레딧이 바로 지급된다.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── 관리자 계정 (선택) ──────────────────────────────────────────────────
# 둘 다 설정하면 docker compose 기동 시 무제한 관리자 계정이 만들어진다.
# 직접 만들려면: npm run admin -- admin@example.com '비밀번호8자이상'
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── 미디어 파이프라인 ───────────────────────────────────────────────────
STORAGE_DIR="./storage"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
YTDLP_PATH="yt-dlp"
PYTHON_PATH="python3"

# faster-whisper 모델: tiny / base / small / medium / large-v3
WHISPER_MODEL="small"
WHISPER_DEVICE="cpu"          # cpu | cuda
WHISPER_COMPUTE_TYPE="int8"   # int8 | float16 | float32
WHISPER_LANGUAGE="ko"         # 빈 값이면 자동 감지

# 워커 동시 처리 개수
WORKER_CONCURRENCY="1"
WORKER_POLL_MS="3000"
